{
  "name": "nijer-bazaar-server",
  "version": "2.0.0",
  "description": "Nijer Bazaar Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "npx drizzle-kit push",
    "db:studio": "npx drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:reset-password": "tsx src/scripts/resetAdminPassword.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Nijer Bazaar",
  "license": "ISC",
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "nodemon": "^1.14.10",
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}