# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# postgres  -> real PostgreSQL (production)
# pglite    -> embedded Postgres-in-WASM (local dev / demo / tests, no install)
DB_DRIVER=pglite
PGLITE_DIR=./.pglite

# Used only when DB_DRIVER=postgres
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nijer_bazaar
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Two separate secrets: a customer token must never unlock admin routes.
JWT_SECRET=change-me-customer-secret-at-least-32-chars
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-chars

# SPA origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@nijerbazaar.com
SEED_ADMIN_PHONE=01700000000
# Leave empty to have a random password generated into server/seed-credentials.txt
SEED_ADMIN_PASSWORD=

# ── Notification providers (all optional) ────────────────────────────────────
# When these are empty the API reports the channel as "not configured" instead
# of pretending a message was delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PREFIX=/uploads
MAX_UPLOAD_MB=5
